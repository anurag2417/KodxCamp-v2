{
  "name": "@kodxcamp/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript types across KodxCamp workspaces.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.types.ts",
    "./auth": "./src/auth.types.ts",
    "./access": "./src/access.types.ts",
    "./content": "./src/content.types.ts",
    "./stats": "./src/stats.types.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@kodxcamp/eslint-config": "workspace:*",
    "@kodxcamp/tsconfig": "workspace:*",
    "eslint": "9.15.0",
    "typescript": "5.7.2"
  }
}
