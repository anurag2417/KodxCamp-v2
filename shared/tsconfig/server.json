{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "KodxCamp Server",
  "extends": "./node.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false
  }
}
