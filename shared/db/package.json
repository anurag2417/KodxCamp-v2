{
  "name": "@kodxcamp/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, migrations, and DB client for KodxCamp.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate": "drizzle-kit generate",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "push": "drizzle-kit push"
  },
  "dependencies": {
    "drizzle-orm": "0.38.3",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@kodxcamp/eslint-config": "workspace:*",
    "@kodxcamp/tsconfig": "workspace:*",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.30.1",
    "eslint": "9.15.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
