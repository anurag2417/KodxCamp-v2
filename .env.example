# =============================================================================
# KodxCamp — Environment Variables (Example)
# =============================================================================
# Copy this file to `.env` for local development, or set these as environment
# variables on Render/Neon/etc. NEVER commit a real `.env` file.
#
# Sections below are grouped by which workspace/service reads them.
# Variables marked (required) will fail fast via scripts/check-env.ts if missing.
# =============================================================================

# =============================================================================
# Node / runtime (all services)
# =============================================================================
NODE_ENV=development
# NODE_ENV values: development | test | production

# =============================================================================
# URLs (all services)
# =============================================================================
# The public origin of the static site (portal + clients)
PUBLIC_SITE_URL=http://localhost:3000

# Cross-service URLs for local development
CORE_API_URL=http://localhost:4001
LEARN_API_URL=http://localhost:4002
PRACTICE_API_URL=http://localhost:4003
LIVE_API_URL=http://localhost:4004

# =============================================================================
# Core server
# =============================================================================
# Port the core server listens on (Render sets PORT automatically in production)
PORT=4001

# Shared secret used by GitHub Actions cron jobs to call /internal/* endpoints.
INTERNAL_CRON_SECRET=change-me-to-a-long-random-string

# =============================================================================
# Database (Neon Postgres)
# =============================================================================
# Main pooled connection string (used by all app services at runtime).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Direct (non-pooled) connection string, used by Drizzle Kit for migrations.
DATABASE_URL_DIRECT=postgresql://user:password@host/dbname?sslmode=require

# =============================================================================
# Auth / sessions
# =============================================================================
# Random 32+ byte secrets. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# Access token lifetime in seconds (short — the refresh token renews it)
JWT_ACCESS_TTL_SECONDS=900

# Refresh token lifetime in seconds (long — the "stay logged in" cookie)
JWT_REFRESH_TTL_SECONDS=2592000

# Cookie domain. Leave empty for localhost; set to your domain in production.
COOKIE_DOMAIN=

# Cookie security. Set to "true" in production (requires HTTPS).
COOKIE_SECURE=false

# Cookie SameSite mode: lax | strict | none
COOKIE_SAME_SITE=lax

# =============================================================================
# OAuth providers
# =============================================================================
# Google — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# GitHub — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# =============================================================================
# Email (Gmail API — not SMTP)
# =============================================================================
# Google Cloud service account JSON (base64-encoded) with Gmail API access
GMAIL_SERVICE_ACCOUNT_JSON_BASE64=

# The Gmail address that sends all transactional emails
GMAIL_SENDER_ADDRESS=

# The "From" display name
GMAIL_SENDER_NAME=KodxCamp

# =============================================================================
# Cloudflare Turnstile (captcha)
# =============================================================================
# https://dash.cloudflare.com/ → Turnstile → Add site
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =============================================================================
# Sentry (error tracking)
# =============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# =============================================================================
# Analytics
# =============================================================================
# Public analytics site ID (exposed to clients via /api/config)
ANALYTICS_SITE_ID=

# =============================================================================
# Feature flags (overridable from admin UI at runtime)
# =============================================================================
# "hard" = require login before any Run; "soft" = N free runs first
RUN_GATE_MODE=soft
RUN_GATE_FREE_RUNS=3
